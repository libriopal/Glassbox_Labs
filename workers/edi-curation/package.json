{
  "name": "@glassbox/workers-edi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Out-of-process EDI curation worker (handoff_p2/05_WORKERS_SPEC.md).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:edi-no-unscored-promotion": "tsx verify-edi-no-unscored-promotion.ts",
    "verify:worker-processes-job": "tsx verify-worker-processes-job.ts",
    "verify": "npm run verify:edi-no-unscored-promotion && npm run verify:worker-processes-job"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@glassbox/genome-engine": "workspace:*",
    "@glassbox/edi": "workspace:*",
    "@glassbox/store": "workspace:*"
  }
}
